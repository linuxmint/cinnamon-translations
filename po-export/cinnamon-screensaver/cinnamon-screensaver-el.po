#: src/cinnamon-screensaver-command.py:41
msgid "Causes the screensaver to exit gracefully"
msgstr "Προκαλεί ομαλή έξοδο από την προφύλαξη οθόνης"

#: src/cinnamon-screensaver-command.py:43
msgid "Query the state of the screensaver"
msgstr "Ερώτημα για την κατάσταση της προφύλαξης οθόνης"

#: src/cinnamon-screensaver-command.py:45
msgid "Query the length of time the screensaver has been active"
msgstr "Ερώτημα για το χρονικό διάστημα που ήταν ενεργή η προφύλαξη οθόνης"

#: src/cinnamon-screensaver-command.py:47
msgid "Tells the running screensaver process to lock the screen immediately"
msgstr ""
"Ειδοποιεί την εκτελούμενη διεργασία της προφύλαξης οθόνης για να κλειδώσει "
"την οθόνη άμεσα"

#: src/cinnamon-screensaver-command.py:49
msgid "Turn the screensaver on (blank the screen)"
msgstr "Ενεργοποίηση της προφύλαξης οθόνης (απενεργοποίηση οθόνης)"

#: src/cinnamon-screensaver-command.py:51
msgid "If the screensaver is active then deactivate it (un-blank the screen)"
msgstr ""
"Εάν η προφύλαξη οθόνης είναι ενεργή, τότε να γίνει απενεργοποίησή της "
"(επανενεργοποίηση οθόνης)"

#: src/cinnamon-screensaver-command.py:53
msgid "Version of this application"
msgstr "Έκδοση αυτής της εφαρμογής"

#: src/cinnamon-screensaver-command.py:55
msgid "Message to be displayed in lock screen"
msgstr "Το μήνυμα που θα εμφανίζεται στην οθόνη κλειδώματος"

#: src/cinnamon-screensaver-command.py:105
msgid "The screensaver is active\n"
msgstr "Η προφύλαξη οθόνης είναι ενεργή\n"

#: src/cinnamon-screensaver-command.py:107
msgid "The screensaver is inactive\n"
msgstr "Η προφύλαξη οθόνης είναι ανενεργή\n"

#: src/cinnamon-screensaver-command.py:111
msgid "The screensaver is not currently active.\n"
msgstr "Η προφύλαξη οθόνης δεν είναι ενεργή αυτήν τη στιγμή.\n"

#: src/cinnamon-screensaver-command.py:113
#, python-format
msgid "The screensaver has been active for %d second.\n"
msgid_plural "The screensaver has been active for %d seconds.\n"
msgstr[0] "Η προφύλαξη οθόνης ήταν ενεργή για %d δευτερόλεπτο.\n"
msgstr[1] "Η προφύλαξη οθόνης ήταν ενεργή για %d δευτερόλεπτα.\n"

#: src/manager.py:315
msgid "Cinnamon Screensaver has experienced an error"
msgstr "Προέκυψε σφάλμα στην προφύλαξη οθόνης του Cinnamon"

#: src/manager.py:317
msgid ""
"The 'cs-backup-locker' process terminated before the screensaver did. Please "
"report this issue and try to describe any actions you may have performed "
"prior to this occurring."
msgstr ""
"Η διεργασία «cs-backup-locker» τερματίστηκε πριν από την προφύλαξη οθόνης. "
"Αναφέρετε αυτό το πρόβλημα και περιγράψτε τυχόν ενέργειες που εκτελέσατε "
"πριν προκύψει το σφάλμα."

#: src/passwordEntry.py:23 src/unlock.py:216
msgid "Please enter your password..."
msgstr "Εισαγάγετε τον κωδικό πρόσβασής σας..."

#: src/unlock.py:96
msgid "Unlock"
msgstr "Ξεκλείδωμα"

#: src/unlock.py:107
msgid "Switch User"
msgstr "Αλλαγή χρήστη"

#: src/unlock.py:189
msgid "Incorrect password"
msgstr "Λανθασμένος κωδικός πρόσβασης"

#: src/unlock.py:206
msgid "Checking..."
msgstr "Έλεγχος..."

#: src/unlock.py:250
msgid "You have the Caps Lock key on."
msgstr "Το πλήκτρο Caps Lock είναι ενεργό."

#. This is the first line of text for the backup-locker, explaining how to switch to tty
#. and run 'cinnamon-unlock-desktop' command.  This appears if the screensaver crashes.
#: backup-locker/cs-backup-locker.c:255
msgid "Something went wrong with the screensaver."
msgstr "Κάτι πήγε στραβά με την προφύλαξη οθόνης."

#. (continued) This is a subtitle
#: backup-locker/cs-backup-locker.c:265
msgid "We'll help you get your desktop back"
msgstr "Θα σας βοηθήσουμε να επαναφέρετε την επιφάνεια εργασίας σας"

#. (new section) Bulleted list of steps to take to unlock the desktop;
#: backup-locker/cs-backup-locker.c:276
#, c-format
msgid "Switch to a console using <Control-Alt-F%u>."
msgstr "Μεταβείτε σε μια κονσόλα πατώντας τα <Control-Alt-F%u>."

#. (list continued)
#: backup-locker/cs-backup-locker.c:278
msgid "Log in by typing your user name followed by your password."
msgstr ""
"Συνδεθείτε πληκτρολογώντας το όνομα χρήστη σας ακολουθούμενο από τον κωδικό "
"πρόσβασής σας."

#. (list continued)
#: backup-locker/cs-backup-locker.c:280
msgid "At the prompt, type 'cinnamon-unlock-desktop' and press Enter."
msgstr ""
"Στη γραμμή εντολών, πληκτρολογήστε «cinnamon-unlock-desktop» και πατήστε "
"Enter."

#. (list continued)
#: backup-locker/cs-backup-locker.c:282
#, c-format
msgid "Switch back to your unlocked desktop using <Control-Alt-F%u>."
msgstr ""
"Επιστρέψτε στην ξεκλείδωτη επιφάνεια εργασίας σας πατώντας τα <Control-Alt-"
"F%u>."

#. (end section) Final words after the list of steps
#: backup-locker/cs-backup-locker.c:287
msgid "If you can reproduce this behavior, please file a report here:"
msgstr ""
"Εάν μπορείτε να αναπαράγετε αυτήν τη συμπεριφορά, υποβάλετε μια αναφορά εδώ:"
