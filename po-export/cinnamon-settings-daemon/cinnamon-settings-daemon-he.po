#: plugins/power/csd-power-manager.c:1386
msgid "Computer will suspend very soon unless it is plugged in."
msgstr "מחשב יושעה בקרוב מאוד אם לא יחובר לחשמל."

#: plugins/power/csd-power-manager.c:1390
msgid "Computer will hibernate very soon unless it is plugged in."
msgstr "המחשב ייכנס לתרדמה בקרוב מאוד אם לא יחובר לחשמל."

#: plugins/power/csd-power-manager.c:1394
msgid "Computer will shutdown very soon unless it is plugged in."
msgstr "המחשב יכבה בקרוב מאוד אם לא יחובר לחשמל."

#: plugins/power/csd-power-manager.c:1402
#: plugins/power/csd-power-manager.c:1590
msgid "UPS critically low"
msgstr "עוצמת אל־פסק חלשה באופן מהותי"

#: plugins/power/csd-power-manager.c:1408
#, c-format
msgid ""
"Approximately %s of remaining UPS power (%.0f%%). Restore AC power to your "
"computer to avoid losing data."
msgstr ""
"נותרו בקרוב %s עוצמת גיבוי באל־פסק (%.0f%%). נא לחבר את המחשב לחשמל  למניעת "
"אבדן נתונים."

#: plugins/power/csd-power-manager.c:1417
msgid ""
"Wireless mouse is very low in power. This device will soon stop functioning "
"if not charged."
msgstr ""
"עוצמת סוללת עכבר אלחוטי חלשה מאוד. התקן זה יחדל לתפקד בקרוב אם לא יטען."

#: plugins/power/csd-power-manager.c:1424
msgid ""
"Wireless keyboard is very low in power. This device will soon stop "
"functioning if not charged."
msgstr ""
"עוצמת סוללת מקלדת אלחוטית חלשה מאוד. התקן  זה יחדל לתפקד בקרוב אם לא יטען."

#: plugins/power/csd-power-manager.c:1432
#, c-format
msgid ""
"PDA is very low in power (%.0f%%). This device will soon stop functioning if "
"not charged."
msgstr ""
"עוצמת סוללת מחשב כף־יד חלשה מאוד (%.0f%%). התקן זה יחדל לתפקד בקרוב אם לא "
"יטען."

#: plugins/power/csd-power-manager.c:1442
#, c-format
msgid ""
"Cell phone is very low in power (%.0f%%). This device will soon stop "
"functioning if not charged."
msgstr ""
"עוצמת סוללת טלפון־נייד חלשה מאוד (%.0f%%). התקן זה יחדל לתפקד בקרוב אם לא "
"יטען."

#: plugins/power/csd-power-manager.c:1452
#, c-format
msgid ""
"Media player is very low in power (%.0f%%). This device will soon stop "
"functioning if not charged."
