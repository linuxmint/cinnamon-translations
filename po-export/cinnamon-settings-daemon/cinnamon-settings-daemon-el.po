msgstr "Προστέθηκε βαθμονόμηση χρωμάτων συσκευής"

#: plugins/color/csd-color-calibrate.c:363
msgid "Color calibration device removed"
msgstr "Αφαιρέθηκε βαθμονόμηση χρωμάτων συσκευής"

