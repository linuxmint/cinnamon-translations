msgstr "Fren tasefsit"

#. settings-example@cinnamon.org->settings-schema.json->long-text->description
msgid "You can type paragraphs and lists here"
msgstr "Tzemreḍ ad taruḍ tiseddarin akked tebdarin dagi"

#. settings-example@cinnamon.org->settings-schema.json->long-text->tooltip
msgid ""
"This setting type is useful for multi-line lists, and text that is too long "
"to fit in an entry widget.\n"
"You can manually set the height of the text view with the 'height' property. "
"This one is set to 150. Default is 200."
msgstr ""
"Anaw-agi n usmenyaf yenfeɛ di tebdarin s waṭas n izirigen akked iḍrisen "
"iɣezfanen ur nezmir ara ad ersen deg urti n uḍris.\n"
"Tzemreḍ ad tesbaduḍ teɣzi s wayla 'height'. Dagi yettusbadu ɣer 150. S "
"lexṣas yettusbadu ɣer 200."

#. settings-example@cinnamon.org->settings-schema.json->date-
#. select->description
msgid "Choose a Date"
msgstr "Fren azemz"

#. settings-example@cinnamon.org->settings-schema.json->time-
#. select->description
msgid "Choose a Time"
msgstr "Fren akud"

#. settings-example@cinnamon.org->settings-schema.json->tree->description
msgid "Custom tree widget"
msgstr "Awiǧit n useklu yugnen"

#. settings-example@cinnamon.org->settings-schema.json->tree->columns->title
