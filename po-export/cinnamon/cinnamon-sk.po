msgstr "Cesta k súboru"

#. settings-example@cinnamon.org->settings-schema.json->show-deps-
#. section->description
msgid "Show the dependencies section"
msgstr "Zobraziť sekciu so závislosťami"

#. settings-example@cinnamon.org->settings-schema.json->show-deps-
#. section->tooltip
msgid ""
"Checking this box shows the Dependencies section below. Unchecking hides it."
msgstr ""
"Keď je toto políčko zaškrtnuté ukazuje sa oddiel závislostí. Keď nie je, "
"oddiel je skrytý."

#. settings-example@cinnamon.org->settings-schema.json->deps-info->description
msgid ""
"You can see this section because the switch above is on. Try switching it "
"off and see what happens."
msgstr ""
"Tento oddiel vidíte lebo políčko je zaškrtnuté. Skúste ho odškrtnúť a "
"uvidíte čo sa stane."

#. settings-example@cinnamon.org->settings-schema.json->dep-combo->description
msgid "Show info"
msgstr "Zobraziť informácie"

#. settings-example@cinnamon.org->settings-schema.json->dep-combo->options
msgid "Show info #1"
msgstr "Zobraziť informáciu č. 1"

#. settings-example@cinnamon.org->settings-schema.json->dep-combo->options
msgid "Show info #2"
msgstr "Zobraziť informáciu č. 2"

#. settings-example@cinnamon.org->settings-schema.json->dep-combo->options
msgid "Don't show info #1 or #2"
msgstr "Nezobrazovať informáciu č. 1 alebo č. 2"

#. settings-example@cinnamon.org->settings-schema.json->dep-combo-
#. info1->description
msgid ""
"Info #1: You are seeing this info because the first option is selected in "
"the combo box above. Try selecting different options to see different "
"information."
msgstr ""
"Informácia č. 1: Toto vidíte lebo v poli je vybraná prvá položka. Skúste si "
"tiež vybrať inú položku."

#. settings-example@cinnamon.org->settings-schema.json->dep-combo-
#. info2->description
msgid ""
"Info #2: You are seeing different text now because you selected the second "
"option in the combo box above."
msgstr ""
"Informácia č. 2: Toto vidíte lebo ste si v poli vybrali druhú položku."

#. settings-example@cinnamon.org->settings-schema.json->dep-spin->description
msgid "Number value"
msgstr "Číselná hodnota"

#. settings-example@cinnamon.org->settings-schema.json->dep-spin-
#. info1->description
msgid "The value of the spinner above is less than 5"
msgstr "Hodnota políčka je väčšia ako 5"

#. settings-example@cinnamon.org->settings-schema.json->dep-spin-
#. info2->description
msgid "The value of the spinner above is greater than or equal to 5"
msgstr "Hodnota políčka je rovnaká alebo väčšia ako 5"

#. settings-example@cinnamon.org->settings-schema.json->custom-
#. widget->description
msgid "Try out this custom widget!"
msgstr "Vyskúšajte túto vlastnú miniaplikáciu!"

#. cornerbar@cinnamon.org->metadata.json->name
msgid "Corner bar"
msgstr "Rohová lišta"

#. cornerbar@cinnamon.org->metadata.json->description
msgid ""
"A bar designed to be placed in the corner, used to show the desktop, "
"desklets, the workspace selector or the window selector."
msgstr ""
"Lišta určená na umiestnenie do rohu, ktorá sa používa na zobrazenie "
"pracovnej plochy, pracovných plôch, selektora pracovného priestoru alebo "
"selektora okien."

#. cornerbar@cinnamon.org->settings-schema.json->click-action->description
msgid "Click action"
msgstr "Akcia po kliknutí"

#. cornerbar@cinnamon.org->settings-schema.json->shift-click-
#. action->description
msgid "Shift + click action"
msgstr "Shift + akcia kliknutia"

#. cornerbar@cinnamon.org->settings-schema.json->shift-middle-click-
#. action->description
msgid "Shift + middle click action"
msgstr "Shift + akcia kliknutia stredným tlačidlom"

#. cornerbar@cinnamon.org->settings-schema.json->scroll-behavior->options
msgid "Switch workspaces"
msgstr "Prepnúť pracovné plochy"

#. cornerbar@cinnamon.org->settings-schema.json->scroll-behavior->options
msgid "Switch workspaces (reversed)"
msgstr "Prepnúť pracovné plochy (obrátené)"

#. network@cinnamon.org->metadata.json->description
msgid "Network manager applet"
msgstr "Aplet na správu sietí"

#. network@cinnamon.org->settings-schema.json->keyOpen->tooltip
msgid "Set keybinding(s) to show the network applet menu."
msgstr "Nastaviť klávesové skratky na zobrazenie ponuky sieťového apletu."

#. windows-quick-list@cinnamon.org->metadata.json->name
msgid "Windows Quick List"
msgstr "Rýchly zoznam okien"

#. windows-quick-list@cinnamon.org->metadata.json->description
msgid "Quickly access windows from all workspaces"
msgstr "Rýchlo pristúpiť k oknám zo všetkých pracovných plôch"

#. keyboard@cinnamon.org->metadata.json->description
msgid "Keyboard layout"
msgstr "Rozloženie klávesnice"

#. nightlight@cinnamon.org->metadata.json->description
msgid "Activate/deactivate Night Light mode."
msgstr "Aktivujte / deaktivujte režim nočného osvetlenia."

#. clock@cinnamon.org->metadata.json->name
msgid "Clock desklet"
msgstr "Desklet s hodinami"

#. clock@cinnamon.org->metadata.json->description
