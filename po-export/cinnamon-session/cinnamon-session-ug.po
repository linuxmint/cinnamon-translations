#: cinnamon-session-quit/cinnamon-session-quit.py:57
msgid "Log out"
msgstr "تىزىمدىن چىق"

#: cinnamon-session-quit/cinnamon-session-quit.py:59
msgid "Power off"
msgstr "توكنى ئۈز"

#: cinnamon-session-quit/cinnamon-session-quit.py:63
msgid "Ignoring any existing inhibitors. Implies --no-prompt"
msgstr "نۆۋەتتىكى چەكلىمە ئامىللىرىغا پەرۋا قىلما. Implies --no-prompt"

#: cinnamon-session-quit/cinnamon-session-quit.py:65
msgid "Don't prompt for user confirmation"
msgstr "ئىشلەتكۈچى جەزملەشنى كۆرسەتمە"

#: cinnamon-session-quit/cinnamon-session-quit.py:263
msgid "Log out of this system now?"
msgstr "بۇ سىستېمىدىن ھازىر تىزىمدىن چىقامسىز؟"

#: cinnamon-session-quit/cinnamon-session-quit.py:270
msgid "Shut down this system now?"
msgstr "بۇ سىستېمىنى ھازىر تاقامسىز؟"

#: cinnamon-session-quit/cinnamon-session-quit.py:283
#: cinnamon-session-quit/cinnamon-session-quit.glade.h:10
msgid "Restart this system now?"
msgstr "سىستېمىنى ھازىرلا قايتا قوزغاتسۇنمۇ؟"

#: cinnamon-session-quit/cinnamon-session-quit.py:341
#, c-format
msgid "You will be automatically logged out in %d second."
msgid_plural "You will be logged out in %d seconds."
msgstr[0] "%d سېكۇنتتىن كېيىن ئۆزلۈكىدىن تىزىمدىن چىقىسىز."

#: cinnamon-session-quit/cinnamon-session-quit.py:347
#, c-format
msgid "This system will be automatically shut down in %d second."
msgid_plural "This system will be shut down in %d seconds."
msgstr[0] "بۇ سىستېما %d سېكۇنتتىن كېيىن ئۆزلۈكىدىن تاقىلىدۇ."

#: cinnamon-session-quit/cinnamon-session-quit.py:353
#, c-format
msgid "This system will be automatically restarted in %d second."
msgid_plural "This system will be restarted in %d seconds."
msgstr[0] "سىستېما يەنە %d سېكۇنتتىن كېيىن قايتا قوزغىلىدۇ."

#: cinnamon-session/csm-manager.c:1421 cinnamon-session/csm-manager.c:3143
msgid "Not responding"
msgstr "ئىنكاس يوق"

#: cinnamon-session/csm-process-helper.c:123
#, c-format
msgid "Exited with code %d"
msgstr "%d كودى ئىلە چېكىندى"

#: cinnamon-session/csm-process-helper.c:128
#, c-format
msgid "Killed by signal %d"
msgstr "سىگنال %d تەرىپىدىن ئۆلتۈرۈلدى"

#: cinnamon-session/csm-process-helper.c:133
#, c-format
msgid "Stopped by signal %d"
msgstr "سىگنال %d تەرىپىدىن توختىتىلدى"

#: cinnamon-session/csm-xsmp-client.c:558
msgid "Remembered Application"
msgstr "پىروگراممىنى ئەستە تۇت"

#: cinnamon-session/csm-xsmp-client.c:1197
msgid "This program is blocking logout."
msgstr "بۇ پىروگرامما تىزىمدىن چىقىشنى چەكلەيدۇ."

#: cinnamon-session/csm-xsmp-server.c:340
msgid ""
"Refusing new client connection because the session is currently being shut "
"down\n"
msgstr ""
"يېڭى ئىشلەتكۈچى باغلانىشى رەت قىلىندى. چۈنكى جەريانچاق تاقىلىۋاتىدۇ\n"

#: cinnamon-session/csm-xsmp-server.c:609
#, c-format
msgid "Could not create ICE listening socket: %s"
msgstr "ICE تىڭشاش روزېتكىسى قۇرالمىدى: %s"

#: cinnamon-session/inhibit-dialog-info.c:131
msgid "Unknown"
msgstr "يوچۇن"

#: cinnamon-session/main.c:208
msgid "Override standard autostart directories"
msgstr "كۆڭۈلدىكى ئۆزلۈكىدىن قوزغىلىش مۇندەرىجىسىنىڭ ئورنىنى ئىگىلىيەلمىدى"

#: cinnamon-session/main.c:208
msgid "AUTOSTART_DIR"
msgstr "AUTOSTART_DIR"

#: cinnamon-session/main.c:209
msgid "Session to use"
msgstr "ئىشلىتىدىغان جەريانچاق"

#: cinnamon-session/main.c:209
msgid "SESSION_NAME"
msgstr "SESSION_NAME"

#: cinnamon-session/main.c:210
msgid "Enable debugging code"
msgstr "سازلاش كودىنى قوزغات"

#: cinnamon-session/main.c:211
msgid "Do not load user-specified applications"
msgstr "ئىشلەتكۈچى بەلگىلىگەن پىروگراممىنى يۈكلىمە"

#: cinnamon-session/main.c:212
msgid "Version of this application"
msgstr "بۇ پىروگراممىنىڭ نەشرى"

#: cinnamon-session/main.c:214
msgid "Show the fail whale dialog for testing"
msgstr "سىناش ئۈچۈن fail whale سۆزلەشكۈسىنى كۆرسىتىڭ"

#: cinnamon-session/main.c:245
msgid " - the Cinnamon session manager"
msgstr " Cinnamon جەريانچاق باشقۇرغۇچ"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:1
msgid "Session"
msgstr "جەريانچاق"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:2
msgid "S_uspend"
msgstr "توڭلات(_U)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:3
msgid "_Hibernate"
msgstr "ئۈچەككە كىر(_H)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:4
msgid "_Switch User"
msgstr "ئىشلەتكۈچى ئالماشتۇر(_S)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:5
msgid "_Cancel"
msgstr "ۋاز كەچ(_C)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:6
msgid "_Restart"
msgstr "قايتا قوزغات(_R)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:7
msgid "_Log Out"
msgstr "تىزىمدىن چىق(_L)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:8
msgid "_Shut Down"
msgstr "تاقا(_S)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:9
msgid "_Ignore and continue"
msgstr "پەرۋا قىلماي داۋاملاشتۇر(_I)"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:11
msgid "Some programs are still running:"
msgstr "بەزى پىروگراممىلار يەنىلا ئىجرا قىلىنىۋاتىدۇ:"

#: cinnamon-session-quit/cinnamon-session-quit.glade.h:12
msgid ""
"Waiting for programs to finish.  Interrupting these programs may cause you "
"to lose work."
msgstr ""
"پىروگرامما تاماملىنىشنى كۈتۈۋاتىدۇ. بۇ پىروگراممىنى ئۈزۈش خىزمەت "
"نەتىجىڭىزنىڭ يوقىلىشىنى كەلتۈرۈپ چىقىرىشى مۇمكىن."
